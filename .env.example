# Vercel Deployment (copy to GitHub Secrets as VERCEL_TOKEN)
# VERCEL_TOKEN=your_vercel_token_here

# Site configuration
NEXT_PUBLIC_SITE_URL=https://dppet.shop
NEXT_PUBLIC_GITHUB_URL=https://github.com/yourusername/dppet-shop

# Analytics (optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Email (optional for contact forms)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
